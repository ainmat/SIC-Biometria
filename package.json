{
  "name": "sic-biometria",
  "version": "2.0.0",
  "description": "Sistema Integrado de Controle de Biometria - Prefeitura de Osasco",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --no-coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --no-coverage",
    "lint": "eslint js/ --ext .js,.mjs",
    "lint:fix": "eslint js/ --ext .js,.mjs --fix",
    "format": "prettier --write js/ css/ *.html",
    "validate": "html-validate *.html",
    "optimize": "npm run build && npm run optimize-images",
    "analyze": "npm run build && npx -y source-map-explorer \"dist/assets/*.js\"",
    "security:audit": "npm audit",
    "performance:test": "lighthouse --chrome-flags='--headless' --output=html --output-path=./reports/lighthouse http://localhost:3000"
  },
  "keywords": [
    "biometria",
    "controle",
    "prefeitura",
    "osasco",
    "dashboard",
    "chamados",
    "sistema"
  ],
  "author": {
    "name": "Prefeitura de Osasco",
    "email": "ti@osasco.sp.gov.br"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-legacy": "^5.4.1",
    "autoprefixer": "^10.4.18",
    "cssnano": "^6.0.3",
    "eslint": "^8.57.0",
    "html-validate": "^8.2.0",
    "imagemin": "^8.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-svgo": "^10.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^11.7.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.2.5",
    "source-map-explorer": "^2.5.3",
    "terser": "^5.27.0",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@supabase/supabase-js": "^2.39.3",
    "@tailwindcss/vite": "^4.3.1",
    "@tsparticles/engine": "^4.2.1",
    "@tsparticles/react": "^4.2.1",
    "@tsparticles/slim": "^4.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
